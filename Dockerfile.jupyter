# ===========================================================================
# CIDeconvolve — optional Bilayers Jupyter Docker image
# ===========================================================================
# Build this image after the headless image. It follows the Bilayers convention
# of publishing a separate interface-specific tag, for example:
#
#   w_cideconvolve:v3.0.0-beta2-jupyter
#   w_cideconvolve:latest-jupyter
#
# The base image remains the headless workflow image used by BIOMERO and batch
# runs. This image starts JupyterLab with the generated Bilayers notebook.
# ===========================================================================

ARG BASE_IMAGE=w_cideconvolve:latest
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# pip needs git for installing the pinned Bilayers package from GitHub.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_jupyter.txt /app/requirements_jupyter.txt
RUN python -m pip install --no-compile -r /app/requirements_jupyter.txt

COPY docker/prepare_bilayers_interface.py /app/docker/prepare_bilayers_interface.py
RUN mkdir -p /app/notebooks \
    && python /app/docker/prepare_bilayers_interface.py \
        --config /app/config.yaml \
        --workdir /app \
        --interface jupyter \
        --output /app/notebooks/cideconvolve_bilayers.ipynb

ENV JUPYTER_PORT=8888

EXPOSE 8888

ENTRYPOINT ["sh", "-c", "jupyter lab --ip=0.0.0.0 --port=${JUPYTER_PORT:-8888} --no-browser --allow-root --ServerApp.token='' --ServerApp.password='' --notebook-dir=/app/notebooks"]
